public Map<Character,Integer> vocales(Tree<Character> arbol){

    Map<Character,Integer> mapeo = new Mapeo<>(); //c1

        if(arbol==null) return mapeo; //

    try{

        vocalAUX(arbol.root(), mapeo);
        return mapeo;

    } catch(EmptyTreeException e){

        return mapeo;
    }
}

public void vocalAUX(Position<Character> p, Map<Character,Integer> mapeo){

    Tnodo<Character> nodo = checkPosition(p);
    for(Tnodo<Character> hijo : nodo.getHijos()){
        vocalAUX(hijo,mapeo);
    }

    if(esVocal(nodo.element())){
        Character elem = nodo.element();
        if(mapeo.get(elem)==null) mapeo.put(elem,1);
        else mapeo.put(elem,mapeo.get(elem)+1)
    }

}

private boolean esVocal(char c){
    return c=='a' || c=='e' || c=='i' || c=='o' || c=='u';
}


