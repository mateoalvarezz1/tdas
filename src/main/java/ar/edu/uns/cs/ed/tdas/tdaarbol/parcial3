receptor del mensaje. Si utiliza otros métodos del TDAArbol deberá implementarlos */

public int sizeSubarbol(Position<E> p){
    Tnodo<E> nodo = checkPosition(p); //c1
    if(nodo==raiz) return size(); //c2 O(1)
    return contarSubArbol(nodo); //O(K) donde k es el tamanio del subarbol
    //tiempo = c1 + max(c2,O(K)) = O(K)
}

private int contarSubArbol(Tnodo<E> nodo){
    int cont=1; //S(c4)
    for(Tnodo<E> hijo : nodo.getHijos()){ //en total sobre todas las llamadas: s-1 iteracione
        cont += contarSubArbol(hijo); //c5
    }
    return cont;//c6
}

/* Dado un árbol de caracteres A, un entero x representando un nivel del árbol y un carácter c,
escriba un método que inserte a c como hijo de cada nodo de A que esté en el nivel x y que sea hoja. Por
ejemplo (x=2, c= w): */

public void insertarNivel(Tree<Character> arbol, char c, int x){
    if(arbol==null) throw new InvalidPositionException("Arbol vacio"); //c8
    for(Position<E> nodo : arbol.positions()){ //se va a ejecutar S veces donde S es la cantidad de nodos del arbol
        if(nivel(nodo)==x && vacio(nodo)){ // O(S) + c10
            arbol.addLastChild(nodo, c); //c11
        }
    }

    //tiempo = c8 + S(S+c10+c11) = O(S^2)
}

private int nivel(Position<E> nodo){
    Tnodo<E> n = checkPosition(nodo);//c3
    int cont = 0;//c4
    while(n!=null){ se ejecuta k veces donde k es la cantidad de padres del nodo
        n=n.getPadre(); //c5
        cont++;//c6
    }
    return cont-1;//c7
    //tiempo = c3 + c4 +k(c5+c6) + c7 = O(k) pero en el peor de los casos esta abajo del todo en el arbol 
                                        //por lo tanto me quedaria de O(S)
}

private boolean vacio(Position<E> nodo){ 
    Tnodo<E> n = checkPosition(nodo); //c1
    return n.getHijos().isEmpty(); //c2
    //tiempo = c1 + c2 = O(1)
}

//3 /* Este método recibe un árbol binario a, que representa una
expresión aritmética, y retorna un mapeo cuyas claves son las operaciones aritméticas (+, -, *, /) cuyos
valores asociados corresponden a la cantidad de veces que aparece el operador en a. Recuerde que en un
árbol binario de expresión los operadores se encuentran en los nodos internos y los operandos en las hojas.
Por ejemplo, para el árbol de la figura el mapeo resultante debería ser: {(+, 2), (-, 1), (*, 1), (/, 0)}.
Recuerde que la interfaz BinaryTree vista en clase extiende a la interfaz GTTee */

public Map<Character, Integer> cantOperadores(BinaryTree<Character> a){

    Map<Character,Integer> mapeo = new MapeoConLista<>();
    mapeo.put('+', 0);
    mapeo.put('*', 0);
    mapeo.put('/', 0);
    mapeo.put('-', 0);

    for(Position<Character> nodo : a.positions()){
        if(a.isInternal(nodo)){
            Character c = nodo.element();
            mapeo.put(c,mapeo.get(c)+1);
        }
    }

    return mapeo;
}

public void removeNode(Position<E> p) {
        if(isEmpty()){
            throw new InvalidPositionException("Arbol vacio, no se puede eliminar");
        }
        Nodo<E> nodo = checkPosition(p);
        Nodo<E> hijoIzquierdo = nodo.getLeft();
        Nodo<E> hijoDerecho = nodo.getRight();
        if(hijoIzquierdo != null && hijoDerecho != null){
            throw new InvalidPositionException("No se puede eliminar un nodo con dos hijos, el padre no puede apuntar a dos nodos, solo tiene una unica referencia");
        }
        Nodo<E> hijo;
        if(hijoIzquierdo != null){
            hijo = hijoIzquierdo;
        }else{
            hijo = hijoDerecho;
        }
        if(nodo == raiz){
            raiz = hijo;
            if(hijo != null){
                hijo.setParent(null);
            }
        }
        else{
            Nodo<E> padre = nodo.getParent();
            if(padre.getLeft() == nodo){
                padre.setLeft(hijo);
            }
            else if(padre.getRight() == nodo){
                padre.setRight(hijo);
            }
            else{
                throw new InvalidPositionException("La estructura del arbol es invalida");
            }
            if(hijo != null){
                hijo.setParent(padre);
            }
        }
        size--;
    }